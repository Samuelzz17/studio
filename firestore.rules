
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Note: Write access is intentionally omitted for now for stricter security.
      // User documents should be managed by a trusted backend process or admin.
    }

    // =========================
    // OUTLETS
    // =========================
    match /outlets/{outletId} {

      // READ outlet document only if user has specific access
      allow get: if isAuthenticated()
        && hasOutletAccess(outletId);

      // LIST outlets is not allowed by this rule to prevent querying all outlets.
      // Client should fetch based on user's access list.
      allow list: if false;

      // WRITE to the outlet document only for users with 'owner' role
      allow write: if isOwner();

      // =========================
      // SUBCOLLECTIONS
      // =========================
      match /{subCollection=**} {
        allow read, write: if isAuthenticated()
          && hasOutletAccess(outletId);
      }
    }

    // =========================
    // FUNCTIONS
    // =========================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the user has the 'owner' role.
    // This requires a read to the user's own document.
    function isOwner() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    // Checks if an outletId exists in the user's 'outletAccess' array.
    // This function can only be used in rules for 'get' requests, not 'list'.
    function hasOutletAccess(outletId) {
      return isAuthenticated()
        && outletId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.outletAccess;
    }
  }
}
