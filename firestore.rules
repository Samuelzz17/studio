
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user owns the data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Secure all user data under a top-level `users` collection.
    // This rule uses a recursive wildcard (`{path=**}`) to match any document
    // at any depth beneath a user's personal document (`/users/{userId}`).
    // It grants read and write access only if the requesting user's UID
    // matches the `userId` in the document path.
    match /users/{userId}/{path=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
