
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if the requesting user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users can read and write to their own user document
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // Access to outlets should be controlled, e.g., by checking user roles or specific outlet access lists.
    // For now, we'll require a user to be signed in.
    match /outlets/{outletId}/{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}
