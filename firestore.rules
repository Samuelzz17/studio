
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Note: Write access is intentionally omitted for now for stricter security.
      // User documents should be managed by a trusted backend process or admin.
    }

    // =========================
    // OUTLETS
    // =========================
    match /outlets/{outletId} {

      // READ outlet only if user has access. This covers get and list.
      // The `where ... in` client query is treated as multiple `get`s, which this rule allows.
      allow read: if isAuthenticated() && hasOutletAccess(outletId);

      // WRITE to the outlet document only for users with 'owner' role
      allow write: if isOwner();

      // =========================
      // SUBCOLLECTIONS
      // =========================
      match /{subCollection=**} {
        allow read, write: if isAuthenticated()
          && hasOutletAccess(outletId);
      }
    }

    // =========================
    // FUNCTIONS
    // =========================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the user has the 'owner' role.
    // This requires a read to the user's own document.
    function isOwner() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    // Checks if an outletId exists in the user's 'outletAccess' array.
    function hasOutletAccess(outletId) {
      return isAuthenticated()
        && outletId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.outletAccess;
    }
  }
}
