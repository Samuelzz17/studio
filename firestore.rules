
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow owners to update their own outletAccess list
      allow update: if request.auth != null && request.auth.uid == userId && isOwner();
    }

    // =========================
    // OUTLETS
    // =========================
    match /outlets/{outletId} {

      // GET: Allow if user has access
      allow get: if isAuthenticated() && hasOutletAccess(outletId);
      
      // LIST: Allow only for owners to see all outlets
      allow list: if isOwner();

      // WRITE (Create, Update, Delete): Allow only for owners
      allow write: if isOwner();

      // =========================
      // SUBCOLLECTIONS
      // =========================
      match /{subCollection=**} {
        allow read, write: if isAuthenticated()
          && hasOutletAccess(outletId);
      }
    }

    // =========================
    // FUNCTIONS
    // =========================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the user has the 'owner' role.
    // This requires a read to the user's own document.
    function isOwner() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    // Checks if an outletId exists in the user's 'outletAccess' array.
    function hasOutletAccess(outletId) {
      return isAuthenticated()
        && outletId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.outletAccess;
    }
  }
}
