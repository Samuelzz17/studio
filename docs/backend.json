
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents an application user.",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "operator"] },
        "outletAccess": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "outletAccess", "createdAt"]
    },
    "OutletInfo": {
      "title": "Outlet Info",
      "type": "object",
      "description": "Core information about a business outlet.",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "active", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "A sellable product in the inventory.",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "cost": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price", "cost", "active", "createdAt"]
    },
    "RawMaterial": {
      "title": "Raw Material",
      "type": "object",
      "description": "An ingredient or raw material for products.",
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string", "enum": ["kg", "g", "L", "mL", "pcs"] },
        "stock": { "type": "number" },
        "minimumStock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "unit", "stock", "minimumStock", "createdAt"]
    },
    "AssetInvestment": {
      "title": "Asset Investment",
      "type": "object",
      "description": "A non-sellable business asset.",
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "purchaseDate": { "type": "string", "format": "date-time" },
        "depreciationYears": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "value", "purchaseDate", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "A single POS transaction.",
      "properties": {
        "invoice": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "qty": { "type": "number" },
              "price": { "type": "number" }
            },
            "required": ["productId", "qty", "price"]
          }
        },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoice", "items", "total", "paymentMethod", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "reasoning": "This architecture separates user management from operational data. The top-level 'users' collection handles authentication and access control. The 'outlets' collection contains all business data, strictly siloed by outlet. This ensures data integrity and scalability for a multi-outlet business model. All queries for operational data must be scoped to a specific outlet.",
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "schema": { "$ref": "#/entities/User" },
          "description": "Stores user-specific data like role and outlet access."
        }
      },
      {
        "path": "/outlets/{outletId}/info/details",
        "definition": {
          "schema": { "$ref": "#/entities/OutletInfo" },
          "description": "Singleton document containing core info for an outlet."
        }
      },
      {
        "path": "/outlets/{outletId}/inventory/products/{productId}",
        "definition": {
          "schema": { "$ref": "#/entities/Product" },
          "description": "Sellable products for a specific outlet."
        }
      },
      {
        "path": "/outlets/{outletId}/inventory/raw_materials/{materialId}",
        "definition": {
          "schema": { "$ref": "#/entities/RawMaterial" },
          "description": "Raw materials for a specific outlet."
        }
      },
      {
        "path": "/outlets/{outletId}/inventory/asset_investments/{assetId}",
        "definition": {
          "schema": { "$ref": "#/entities/AssetInvestment" },
          "description": "Asset investments for a specific outlet."
        }
      },
      {
        "path": "/outlets/{outletId}/pos/transactions/{transactionId}",
        "definition": {
          "schema": { "$ref": "#/entities/Transaction" },
          "description": "POS transactions for a specific outlet."
        }
      }
    ]
  }
}
