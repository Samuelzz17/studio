
{
  "entities": {
    "Location": {
      "title": "Location",
      "type": "object",
      "description": "Represents a single business location or outlet.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the location."
        },
        "name": {
          "type": "string",
          "description": "The name of the location (e.g., 'SR Gadjah Mada')."
        }
      },
      "required": ["id", "name"]
    },
    "MenuItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MenuItem",
      "type": "object",
      "description": "Represents a single item on the restaurant's menu.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "price", "imageUrl", "category"]
    },
    "Ingredient": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Ingredient",
      "type": "object",
      "description": "Represents an ingredient used in menu items (Raw Material).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stockLevel": { "type": "number" },
        "unitOfMeasurement": { "type": "string" },
        "lowStockThreshold": { "type": "number" }
      },
      "required": ["id", "name", "stockLevel", "unitOfMeasurement", "lowStockThreshold"]
    },
    "Asset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Asset",
      "type": "object",
      "description": "Represents a non-sellable business asset.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unitOfMeasurement": { "type": "string" }
      },
      "required": ["id", "name", "quantity", "unitOfMeasurement"]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Represents a single customer transaction.",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "totalCost": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "menuItemIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "timestamp", "totalCost", "paymentMethod"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "reasoning": "The structure is multi-tenant by user, and then multi-location within each user. All primary data collections (menuItems, ingredients, etc.) are nested under a specific location, which is nested under the user. This ensures data isolation between users and between locations.",
    "structure": [
      {
        "path": "/users/{userId}/locations/{locationId}",
        "definition": {
          "entityName": "Location",
          "schema": { "$ref": "#/entities/Location" },
          "description": "A user's business locations (outlets)."
        }
      },
      {
        "path": "/users/{userId}/locations/{locationId}/menuItems/{menuItemId}",
        "definition": {
          "entityName": "MenuItem",
          "schema": { "$ref": "#/entities/MenuItem" },
          "description": "Menu items for a specific location."
        }
      },
      {
        "path": "/users/{userId}/locations/{locationId}/ingredients/{ingredientId}",
        "definition": {
          "entityName": "Ingredient",
          "schema": { "$ref": "#/entities/Ingredient" },
          "description": "Ingredients for a specific location."
        }
      },
      {
        "path": "/users/{userId}/locations/{locationId}/assets/{assetId}",
        "definition": {
          "entityName": "Asset",
          "schema": { "$ref": "#/entities/Asset" },
          "description": "Assets for a specific location."
        }
      },
      {
        "path": "/users/{userId}/locations/{locationId}/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": { "$ref": "#/entities/Transaction" },
          "description": "Transactions for a specific location."
        }
      }
    ]
  }
}
